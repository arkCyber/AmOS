<!--
  AmOS System UI — Android **components** fragment (real-device step).

  This is NOT a complete manifest. When the Tauri-Android project is generated
  (cargo tauri android init), merge the <service>/<receiver> entries below into
  gen/android/app/src/main/AndroidManifest.xml of the System UI app — inside
  <application>.

  WHY this file exists (audit, 2026-09-13): these three registrations used to live
  ONLY in the git-ignored generated manifest, hand-added during bring-up. That
  makes them invisible to a clean checkout: `tauri android init` + the documented
  glue mirror produced an APK where the Kotlin was compiled in but **nothing bound
  it** — no in-call UI (AmosInCallService), no call screening (AmosCallScreening
  Service) and no live SMS receive while the process is stopped (SmsReceiver).
  They are tracked now, and `scripts/android-glue-mirror.sh` verifies every
  `android:name` declared here is present in the generated manifest (fail loud).

  The values are copied verbatim from the working generated manifest, including
  the relative `.glue.` prefix Tauri's namespace (`com.amos.ai`) resolves — the
  mirror script compares these literals, so keep them spelled the same way.

  `docs/sms.md` / `docs/REAL_DEVICE_SYSTEM_UI_AUDIT.md` describe the behaviour.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Real call control + incoming-call surface (only active once the user makes
         AmOS the default phone app / ROLE_DIALER). AmOS shows the in-call UI. -->
    <service
        android:name=".glue.AmosInCallService"
        android:exported="false"
        android:foregroundServiceType="phoneCall"
        android:permission="android.permission.BIND_INCALL_SERVICE">
        <intent-filter>
            <action android:name="android.telecom.InCallService" />
        </intent-filter>
        <meta-data
            android:name="android.telecom.IN_CALL_SERVICE_UI"
            android:value="true" />
    </service>

    <!-- Real incoming-call blocking: the system binds this screening service for
         every incoming call while AmOS holds the Call Screening role
         (RoleManager.ROLE_CALL_SCREENING, API 29+). Blocked numbers are rejected
         before the phone rings. -->
    <service
        android:name="com.amos.ai.glue.AmosCallScreeningService"
        android:exported="true"
        android:permission="android.permission.BIND_SCREENING_SERVICE">
        <intent-filter>
            <action android:name="android.telecom.CallScreeningService" />
        </intent-filter>
    </service>

    <!-- Live receive: manifest receiver so SMS_RECEIVED is delivered even when the
         System UI process was not running. Protected broadcast → require the sender
         to hold BROADCAST_SMS (third parties cannot inject messages). -->
    <receiver
        android:name="com.amos.ai.glue.SmsReceiver"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.BROADCAST_SMS">
        <intent-filter android:priority="999">
            <action android:name="android.provider.Telephony.SMS_RECEIVED" />
        </intent-filter>
    </receiver>

    <!-- Exact alarms (REQ-A369, F-TAU-007): the alarm the user set must wake a
         sleeping / dozing phone. `AlarmGlue.schedule` arms it with
         `setExactAndAllowWhileIdle`; this receiver is what runs at that instant —
         it brings the System UI to the front so the WebView's existing notifier
         shows the ring (no notification is posted, which is why POST_NOTIFICATIONS
         is not declared in the permissions fragment).
         `exported="false"` is correct: the broadcast is in-package, and the intent
         carries the alarm id (`EXTRA_ID`) the WebView knows. -->
    <receiver
        android:name="com.amos.ai.glue.AlarmReceiver"
        android:enabled="true"
        android:exported="false" />

    <!-- Whole-screen capture (REQ-A1582 / F-DEV-141). Android requires a foreground
         service of type `mediaProjection` to be running while a `MediaProjection` is
         live — without one, `getMediaProjection` is refused, so this registration is
         part of the capture path rather than decoration. `ScreenRecordGlue` starts it
         from the consent result and stops it when the session ends.
         `exported="false"`: nothing outside the app may start it. The type's own
         permission (`FOREGROUND_SERVICE_MEDIA_PROJECTION`) lives in the permissions
         fragment, and the two have to agree — which is exactly what
         `scripts/android-component-scan.mjs` (K2, the Kotlin → fragment direction) and
         `scripts/android-permission-scan.mjs` (the `screen-record` family) check. -->
    <service
        android:name="com.amos.ai.glue.ScreenRecordService"
        android:enabled="true"
        android:exported="false"
        android:foregroundServiceType="mediaProjection" />

    <!-- The **system input method** (REQ-A1893, `docs/input-method.md` §System IME).
         Until this entry existed, `amos-ime` had one exit only — the System UI's own WebView — and
         no app on the device (a legacy app in the container, or any app on the no-UI
         Android base) could select the pinyin keyboard. This is the platform binding
         that makes the engine reachable from any app.

         `exported="true"` — deliberate, and the opposite of every other service here:
         the **platform** (InputMethodManager, on behalf of the app the user is typing
         into) is the caller that binds it, so it cannot be app-private. `BIND_INPUT_METHOD`
         is the permission the *system* must hold to bind — a signature|privileged
         permission a normal app cannot hold, which is what stops a third-party app from
         binding this service itself. It is therefore **not** a `<uses-permission>` on our
         side (see `scripts/android-permission-scan.mjs`'s `ime` family, whose permission
         list is deliberately empty for exactly that reason; declaring it here as a
         `<uses-permission>` would be judged undeclared).

         `<meta-data android:name="android.view.im">` is what points the platform at
         `res/xml/method.xml` (the subtype list). That resource is a **tracked** file
         (`android-glue/res/xml/method.xml`) mirrored into the generated project by
         `scripts/android-glue-mirror.sh`, which also fails loud when a fragment's
         `@xml/<n>` has no tracked file — a missing resource is an AAPT build error, but a
         *stale* one is a silently wrong subtype.

         The action is `android.view.InputMethod` — the literal value of
         `android.view.inputmethod.InputMethod.SERVICE_INTERFACE`, and the one string in this
         block a reader will get wrong: the platform's discovery query is
         `new Intent(InputMethod.SERVICE_INTERFACE)`, so the package-shaped spelling
         `android.view.inputmethod.InputMethod` (which looks right and is what this file said
         until 2026-09-26) matches nothing, and the IME installs, resolves in `dumpsys
         package`, and is still missing from the method map the Settings keyboard list reads.
         `scripts/ime-action-scan.mjs` compares this literal to the SDK's own constant. -->
    <service
        android:name="com.amos.ai.glue.AmosImeService"
        android:enabled="true"
        android:exported="true"
        android:permission="android.permission.BIND_INPUT_METHOD">
        <intent-filter>
            <action android:name="android.view.InputMethod" />
        </intent-filter>
        <meta-data
            android:name="android.view.im"
            android:resource="@xml/method" />
    </service>

</manifest>
