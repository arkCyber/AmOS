<!--
  AmOS System UI — Android manifest permissions (real-device fragment).

  This is NOT a complete manifest. When the Tauri-Android project is generated
  (cargo tauri android init), merge these <uses-permission> entries into
  gen/android/app/src/main/AndroidManifest.xml of the System UI app.

  Notes:
   * CAMERA is required both by the native producers (AmosGlue/CameraGlue/
     FlashlightGlue torch) and, when the WebView getUserMedia path is used, by the
     Android runtime check + the WebView's own onPermissionRequest grant.
   * RECORD_AUDIO gates the native AAudio mic (assistant voice). INTERNET is
     needed for the store/catalog and the AI daemon's cloud backends.
   * The magnifier / camera WebView demo fallback needs no permission; only the
     live feed does. See docs/REAL_DEVICE_SYSTEM_UI_AUDIT.md § "WebView vs native".
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Magnifier / Camera live feed + native Camera2 preview producer + torch. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />

    <!-- On-device assistant voice: NDK AAudio mic (amos-audio/aaudio). Also the runtime
         permission call recording needs (AmosInCallService's MediaRecorder). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Two-sided call recording (AmosInCallService.setRecording, REQ-A1579 / F-TEL-038).
         AudioSource.VOICE_CALL — the mixed call stream — is gated by CAPTURE_AUDIO_OUTPUT,
         a **signature|privileged** permission a normally-installed app can never hold; only a
         platform-signed build (AmOS as the OS vendor) is granted it. It is declared so the
         requirement stays visible, and the recorder checks it at runtime: granted ⇒ VOICE_CALL
         (two-sided), otherwise it falls back to AudioSource.VOICE_COMMUNICATION, which needs
         only RECORD_AUDIO and captures the near end (this device's microphone). The source
         actually used is recorded in the ledger so the list never claims the far end was
         captured when it was not. -->
    <uses-permission android:name="android.permission.CAPTURE_AUDIO_OUTPUT" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Personal hotspot / Wi-Fi tethering (docs/radio.md §7,
         crates/amos-tauri/android-glue/.../TetheringGlue.kt):
         `TetheringManager#startTethering(TetheringRequest, Executor,
         StartTetheringCallback)` / `#stopTethering`. The public tethering API
         only exists from **API 36** (verified with `javap`: `TetheringManager` is
         absent from the android-34/35 `android.jar`s, and `ConnectivityManager`'s
         tethering members are `@SystemApi`), so below 36 the glue honestly
         reports "unavailable" instead of faking a fallback.
         TETHER_PRIVILEGED is a **signature|privileged** permission — only a
         platform-signed / privileged app can hold it, so a normally-installed
         AmOS gets a refusal, the glue returns `false`, and Rust surfaces a
         provider error: the UI then honestly says the hotspot could not start
         instead of claiming an AP that is not up. Declared (with the lint ignore)
         so the requirement is visible at the manifest level; granting it requires
         a privileged install. ACCESS_NETWORK_STATE above is what the tethering
         state checks need. -->
    <uses-permission android:name="android.permission.TETHER_PRIVILEGED"
        tools:ignore="ProtectedPermissions" />

    <!-- Radios: Wi-Fi + Bluetooth on/off and state (crates/amos-radio/src/android.rs,
         the `android` feature). **Not** privileged — these are the permissions the
         provider's own calls require, and until REQ-A185 none of them was declared,
         so on a real device every read/write threw SecurityException and the
         quick-settings tiles were dead (the compile gate cannot see this: the SDK
         *has* the methods, the permission is an install/runtime concern).

           * ACCESS_WIFI_STATE  — `WifiManager#isWifiEnabled` (the status bar's Wi-Fi
             badge and `radio_status`'s `wifi` bit). Normal ⇒ granted at install.
           * CHANGE_WIFI_STATE  — `WifiManager#setWifiEnabled`. Normal ⇒ granted at
             install, but API 29+ additionally restricts the *caller* to system /
             device-owner apps: on a normally-installed build the platform answers
             `false` and the provider reports that honestly (REQ-A184) instead of
             claiming a switch it did not make.
           * BLUETOOTH / BLUETOOTH_ADMIN — the legacy pair used on API ≤ 30
             (`BluetoothAdapter#isEnabled` / `enable` / `disable`).
           * BLUETOOTH_CONNECT — the API 31+ replacement, a **runtime** permission:
             it is requested at startup (MainActivity.Wiring.kt `requestNeeded`) and
             again on demand by nothing else, so a denial surfaces as a provider
             error rather than a silently-off toggle. On API 33+ the platform also
             forbids non-system apps from *enabling/disabling* Bluetooth at all —
             that refusal is reported, not papered over. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Bluetooth **discovery** (REQ-A200): `BluetoothGlue.startDiscovery` / `bond`
         need the API 31+ **runtime** `BLUETOOTH_SCAN` (below 31 the install-time
         BLUETOOTH/BLUETOOTH_ADMIN pair above covers scanning, which is why that pair
         is capped at 30 and this one is not). `neverForLocation` is accurate: the
         scan is not used to derive the user's location here. Requested at startup by
         `MainActivity.Wiring.kt`, and a denial surfaces as an honest error rather
         than an empty result list.
         BLUETOOTH_ADVERTISE is deliberately **not** declared: it is only needed to
         make *this* device discoverable, and nothing in this tree does that
         (`BluetoothAdapter#setScanMode` is not public SDK) — a declaration with no
         call site would be reported `stale` by scripts/android-permission-scan.mjs. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!-- Real outbound dialing: the AmOS Phone dialer fires ACTION_CALL through
         Android Telecom (needs runtime CALL_PHONE grant; see docs/telephony.md). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- External-storage / media access (docs/android-storage-unify.md §7 and
         crates/amos-media/src/mapping.rs encode the per-API split; this declares
         the union so any installed build has what it needs):
           * API 33+ (Android 13+): granular READ_MEDIA_* per collection.
           * API <=32: legacy READ_EXTERNAL_STORAGE (auto-picked at runtime).
           * MediaStore.insert of our own contributions needs no write permission
             on API 29+; the legacy WRITE is only for API <=28.
         The System UI must request the right subset at runtime (the WebView's
         MainActivity.Wiring.kt REQ_MEDIA branch). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Real SMS (docs/sms.md): read the device inbox (content://sms) and send
         via SmsManager. Both are runtime permissions; SmsGlue.bind installs the
         provider at boot and reads/sends succeed once granted (no re-bind
         needed — the glue checks at call time). SEND/RECEIVE are also what the
         SMS_RECEIVED receiver below requires to observe incoming messages. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Device care (手机管家): list the device's installed packages so the
         uninstall preview/enforcement can run the UninstallGuard policy over the
         real `PackageManager` inventory (see DevCareGlue.kt). Without it, API 30+
         filters the list and the manager honestly shows fewer apps than are
         installed — nothing is faked either way. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Exact alarms — the Clock app's "wake a sleeping phone" half (REQ-A369,
         closing F-TAU-007). `AlarmGlue.schedule` calls
         `AlarmManager#setExactAndAllowWhileIdle`, which needs one of these:

           * USE_EXACT_ALARM (API 33+) — granted at install to apps whose core
             function is alarms/calendar, with no user dialog. This app ships a
             clock with real alarms, so it is the honest declaration;
           * SCHEDULE_EXACT_ALARM (API 31/32) — the per-app "Alarms & reminders"
             grant; `AlarmGlue.schedule` checks `canScheduleExactAlarms()` and,
             when it is false, answers `disallowed` (the host then reports "this
             alarm will not wake the phone" instead of a false success), and
             `AlarmGlue.openExactAlarmSettings` opens the system screen.

         POST_NOTIFICATIONS is now **declared** (REQ-A375): the firing path posts a full-screen-intent
         notification, so it is no longer a declaration without a call site — REQ-A369 deliberately
         left it out while nothing posted one, which is exactly why it is added together with
         `AlarmGlue.notifyAlarm` and the runtime request in `PermissionWire`. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- The firing ring (REQ-A375 / F-TAU-012): a **full-screen-intent** notification is the
         platform-sanctioned way to bring an alarm to the front when the app is in the background
         (a `startActivity` from a receiver is dropped on Android 10+). USE_FULL_SCREEN_INTENT is
         install-time for apps whose core function is alarms/calls (this one ships a clock);
         POST_NOTIFICATIONS is the API 33+ **runtime** permission, requested by
         `PermissionWire.requestNeeded` — without it the notification is silently not posted, so
         the alarm keeps its in-process ring and the receiver logs the refusal. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- `WAKE_LOCK` — measured on the device (REQ-A376): posting the full-screen-intent ring threw
         `SecurityException: Neither user 10172 nor current process has android.permission.WAKE_LOCK`
         on this ROM, so the notification never appeared while the alarm itself fired normally. It is
         a **normal** (install-time) permission, and waking the screen for an alarm is exactly what it
         is for; without the declaration the ring is silently absent — the one failure this path
         cannot tolerate. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Location (REQ-A772 / F-SH-228). **Both** were undeclared until this round, which made
         `LocationManager#getLastKnownLocation("gps")` — the real GNSS read behind the sensor
         snapshot's `gnss` field (`crates/amos-sensor/src/android.rs`) — throw `SecurityException`
         on every device, so the fix was permanently empty and the Maps "定位" button, which went
         through the WebView `navigator.geolocation`, was auto-denied for the same reason (its
         runtime prompt in the generated `RustWebChromeClient` asks for a permission the package
         never declared). Two location paths, both dead, and every gate green — the same shape as
         REQ-A185, and for the same reason: a permission is an install/runtime fact, not a
         compile-time one.

         They are a **runtime** (dangerous) pair and are requested together: the user's choice is
         "precise" vs "approximate", and the native read works with either — declaring only
         ACCESS_FINE_LOCATION would leave the approximate grant, the one most users give, as an
         untracked state of the world. `LocationPermissionGlue` posts the dialog, because the native
         `LocationManager` read — unlike the WebView path — triggers no OS dialog of its own. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- NFC (REQ-A774 / F-AND-006). `NfcGlue.kt` wraps `NfcAdapter` +
         `Ndef` (+ the per-tag `TagTechnology` handles) for foreground dispatch and
         NDEF read/write, reached from six Rust commands in
         `crates/amos-tauri/src/ble.rs` (`nfc_status`, `nfc_start_dispatch`,
         `nfc_stop_dispatch`, `nfc_format_tag`, `nfc_write_message`,
         `nfc_read_bytes`) and from a full WebView screen (`NfcApp.svelte`,
         `lib/nfc.ts`).

         It is a **normal** (install-time) permission, so the declaration *is* the
         whole grant — there is no runtime dialog to post and nothing for a glue to
         request. That is what makes the omission silent: nothing in the tree has to
         name the permission in order for the feature to be built and shipped, so
         nothing notices it is missing.

         This was declared **nowhere tracked** until REQ-A774. The only declaration
         in the tree was a hand-added line in
         `crates/amos-tauri/gen/android/app/src/main/AndroidManifest.xml` — the
         git-ignored, `cargo tauri android init`-regenerated file that REQ-A409's
         own delivery note names as the place NFC was wired up. On a clean checkout
         the app builds, installs, opens the NFC screen and cannot read a tag, and
         `nfc_status` reports `no_hardware` (see REQ-A775 / F-AND-007) either way:
         the two defects are indistinguishable from the outside, which is why they
         are fixed together.

         `android.hardware.nfc` is `required="false"`: AmOS must install on a device
         without NFC (the screen then honestly says so). -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Biometric authentication (REQ-A774 / F-AND-006). `BiometricGlue.kt` uses
         AndroidX `BiometricPrompt` / `BiometricManager`; the **use** permission
         hierarchy comes from the `androidx.biometric` artifact's own manifest and is
         merged in by the manifest merger (`USE_BIOMETRIC` / `USE_FINGERPRINT` both
         appear in the merged manifest and neither is declared by this app) — so
         unlike NFC there is no permission to declare here. What must be tracked is
         the pair of `<uses-feature>` entries, because those decide installability:
         absent, an NFC-only / no-fingerprint device could be filtered out of Play.
         `required="false"` on both is the honest declaration — the biometric screen
         reports "no hardware / not enrolled" and nothing is faked. -->
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.biometrics" android:required="false" />

    <!-- Default-dialer / in-call control (REQ-A774 / F-AND-006). These four are what
         the tracked component fragment's `AmosInCallService` needs to actually bind
         and run:

           * FOREGROUND_SERVICE / FOREGROUND_SERVICE_PHONE_CALL — the service is
             registered with `android:foregroundServiceType="phoneCall"`, and on
             API 34+ starting a foreground service of that type throws
             `SecurityException` without the type's permission. Unlike the other
             entries here this one is required by a **tracked** declaration
             (`AndroidManifest.components.xml`) — the two fragments have to agree,
             which is precisely what no gate checked before REQ-A774.
           * READ_PHONE_STATE / MANAGE_OWN_CALLS — read live call state and drive
             answer/end through `TelecomManager`, granted together with
             `ROLE_DIALER` when the user makes AmOS the default phone app
             (docs/telephony.md §"ROLE_DIALER + InCallService"). Both are
             install-time for a default dialer; without them the in-call UI binds
             and then cannot report the call it was bound for.

         `android.software.telephony` is `required="false"`: AmOS ships the dialer
         screens on Wi-Fi-only tablets too, where they honestly report that there is
         no telephony stack. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!-- The screen-recording foreground service (REQ-A1582 / F-DEV-141).
         `ScreenRecordService` is registered with
         `android:foregroundServiceType="mediaProjection"` because that type is not
         optional: `MediaProjectionManager#getMediaProjection` is only legal while a
         service of that type is running, and on API 34+ starting it without this
         permission throws `SecurityException`. So a normally-installed build has no
         recording at all without the declaration — the same install-time-permission
         shape REQ-A185 and REQ-A774 both were.

         Like `FOREGROUND_SERVICE_PHONE_CALL` above, this is required by a *tracked*
         component declaration (`AndroidManifest.components.xml`), which is what
         `scripts/android-permission-scan.mjs`'s `screen-record` family keeps in step. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-feature android:name="android.software.telephony" android:required="false" />

    <!-- Health & Fitness (REQ-A1454). The wellness pair the Health app draws —
         cumulative step count and heart rate — is produced by `SensorGlue`
         (`TYPE_STEP_COUNTER` / `TYPE_HEART_RATE`, pushed through
         `recordVitals`). Both are **runtime/dangerous** permissions, so the
         declaration is not the grant: `MainActivity.Wiring.kt` has to ask the
         user (and a declared-but-unrequested permission is reported by
         `android-permission-scan`). The version gates are real:

           * ACTIVITY_RECOGNITION — API 29+. Without it `registerListener` for
             `TYPE_STEP_COUNTER` throws `SecurityException` on some ROMs; the glue
             guards the registration, so a refusal degrades to an absent reading
             (null, printed as —), never a fabricated 0.
           * BODY_SENSORS — API 31+. The heart-rate sensor's own grant.

         The `<uses-feature>` pair is `required="false"`: AmOS ships the Health
         screen on hardware with neither sensor, where each reading is honestly
         absent. Declaring them required would filter such devices out of Play
         for a feature that already degrades correctly. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />

</manifest>
