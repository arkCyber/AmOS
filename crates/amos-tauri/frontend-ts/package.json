{
  "name": "amos-ui-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Amos System UI (bun + Vite + Svelte 5 + TypeScript + Tailwind) — light/dark theme + i18n first, consumes the amos.* shared store.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:report": "vite build && node scripts/bundle-report.mjs",
    "preview": "vite preview",
    "test": "node scripts/bun-iso-test.mjs test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "coverage:gate": "node scripts/bun-iso-test.mjs coverage",
    "unwired:scan": "node scripts/unwired-scan.mjs",
    "unwired:selftest": "node scripts/unwired-scan.mjs --selftest",
    "unwired:update": "node scripts/unwired-scan.mjs --update-baseline",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "i18n:selftest": "node scripts/i18n-scan.mjs --selftest",
    "store:scan": "node scripts/store-scan.mjs",
    "store:selftest": "node scripts/store-scan.mjs --selftest",
    "write:scan": "node scripts/write-scan.mjs",
    "write:selftest": "node scripts/write-scan.mjs --selftest",
    "typecheck": "tsc --noEmit",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test:svelte": "vitest run --config vitest.config.ts",
    "test:svelte:watch": "vitest --config vitest.config.ts",
    "check": "bun run test && bun run typecheck && bun run typecheck:svelte && bun run test:svelte && bun run unwired:selftest && bun run unwired:scan && bun run i18n:selftest && bun run i18n:scan && bun run store:selftest && bun run store:scan && bun run write:selftest && bun run write:scan",
    "smoke:ui": "bun scripts/smoke-ui.mjs",
    "smoke:player": "bun scripts/smoke-player.mjs"
  },
  "dependencies": {
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.1.6",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.41",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
