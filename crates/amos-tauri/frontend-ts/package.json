{
  "name": "amos-ui-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Amos System UI (bun + Vite + React + TypeScript + Tailwind) — light/dark theme + i18n first, consumes the amos.* shared store.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "bundle:report": "vite build && node scripts/bundle-report.mjs",
    "preview": "vite preview",
    "test": "node scripts/bun-iso-test.mjs test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov",
    "coverage:gate": "node scripts/bun-iso-test.mjs coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "test:svelte": "vitest run --config vitest.config.ts",
    "test:svelte:watch": "vitest --config vitest.config.ts",
    "check": "bun run test && bun run typecheck && bun run typecheck:svelte && bun run test:svelte",
    "smoke:ui": "bun scripts/smoke-ui.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.13.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/bun": "^1.1.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.41",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
