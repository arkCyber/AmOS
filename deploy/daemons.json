{
  "daemons": [
    {
      "name": "amos-ai",
      "program": "amos-ai",
      "args": ["--socket", "/tmp/amos-ai.sock"],
      "env": [
        ["AMOS_BACKEND", "mock"],
        ["AMOS_SOCKET", "/tmp/amos-ai.sock"]
      ],
      "restart": { "max_restarts": 5, "backoff_secs": 1, "backoff_factor": 2 }
    },
    {
      "name": "amos-translate",
      "program": "amos-translate",
      "args": ["--socket", "/tmp/amos-translate.sock"],
      "env": [
        ["AMOS_TRANSLATE_BACKEND", "mock"],
        ["AMOS_TRANSLATE_TARGET", "zh"],
        ["AMOS_TRANSLATE_SOCKET", "/tmp/amos-translate.sock"],
        ["AMOS_ASR_BACKEND", "mock"]
      ],
      "restart": { "max_restarts": 3, "backoff_secs": 1, "backoff_factor": 2 }
    }
  ]
}
